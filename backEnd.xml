  describe,
  it,
  expect,
  beforeAll,
  afterEach,
  afterAll,
  beforeEach,
} from "@jest/globals";

// ── 1. Mock external services BEFORE importing any app modules ────────────────

const mockNotifyStatusChanged = jest.fn().mockResolvedValue(undefined);
