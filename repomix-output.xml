  pending: "⏳ Pending",
  confirmed: "✅ Confirmed",
  cancelled: "❌ Cancelled",
  completed: "✔️ Completed",
};

const baseStyle = `
  font-family: Arial, sans-serif; color: #333;
  max-width: 600px; margin: auto; padding: 20px;
`;

const tableStyle = `
  border-collapse: collapse; width: 100%; margin-top: 12px;
`;

