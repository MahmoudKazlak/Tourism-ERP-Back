// Expenses report
// GET /api/v1/report/expenses?fromDate=&toDate=&category=
// ─────────────────────────────────────────────────────────────────────────────
export const exportExpenses = asyncHandler(async (req, res) => {
  const { fromDate, toDate, category } = req.query;

  const query = {};
