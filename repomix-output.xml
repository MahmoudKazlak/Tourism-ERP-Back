        <table style="${tableStyle}">
          <tr>
            <td style="${cellStyle}"><strong>Previous Status</strong></td>
            <td style="${cellStyle}">${STATUS_LABELS[oldStatus] || oldStatus}</td>
          </tr>
          <tr>
            <td style="${cellStyle}"><strong>New Status</strong></td>
